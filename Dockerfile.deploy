FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS builder
ENV GO111MODULE=on CGO_ENABLED=0
# 生产服务器直连 proxy.golang.org / sum.golang.org 不通，走国内代理；
# 依赖哈希仍以仓库内 go.sum 为准（readonly 模式不新增 sum 条目）。
ENV GOPROXY=https://goproxy.cn,direct GOSUMDB=off

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
RUN go mod download

COPY . .
RUN mkdir -p web/default/dist web/classic/dist && \
    echo '<!doctype html>' > web/default/dist/index.html && \
    echo '<!doctype html>' > web/classic/dist/index.html
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a

# 生产服务器直连 deb.debian.org **不通**（2026-10-22 实测 curl 超时，构建卡在
# apt-get update 90 分钟；而 mirrors.aliyun.com 0.1s 返回）。与上面 GOPROXY=goproxy.cn
# 同一思路：apt 源换成国内阿里云镜像，并加超时/重试，避免在慢源上空转。
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null || true \
    && apt-get -o Acquire::http::Timeout=20 -o Acquire::Retries=3 update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder /build/new-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
